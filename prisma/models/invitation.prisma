enum InvitationStatus {
    pending
    accepted
    rejected
    canceled
    expired
}

model Invitation {
    id        String    @id
    createdAt DateTime  @default(now()) @db.Timestamp()
    expiresAt DateTime? @db.Timestamp()

    // Who sent the invitation
    senderId String
    sender   User   @relation(fields: [senderId], references: [id])

    // For item sharing
    itemId String?
    item   Item?   @relation(fields: [itemId], references: [id])

    // For workspace invitation
    workspaceId String?
    workspace   Workspace? @relation(fields: [workspaceId], references: [id])

    // Recipients
    recipients InvitationRecipient[]

    @@index([senderId])
    @@index([itemId])
    @@index([workspaceId])
}

model InvitationRecipient {
    id        String   @id
    createdAt DateTime @default(now()) @db.Timestamp()

    // Recipient email
    email String

    // Per-recipient status
    status InvitationStatus @default(pending)

    // Role granted to this recipient
    // For item invitations: PermissionRole (read/write/owner)
    // For workspace invitations: stored as string, maps to WorkspaceMemberRole
    role String @default("read")

    // Parent invitation
    invitationId String
    invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

    // Permission created for item invitations
    permission Permission?

    @@index([invitationId])
    @@index([email])
    @@index([status])
}
