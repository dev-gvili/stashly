model File {
    id         String  @id @default(uuid())
    mimeType   String?
    hash       String?
    extension  String?
    bucket     String
    key        String
    etag       String?
    item       Item    @relation(fields: [id], references: [id], onDelete: Cascade)
}

model Folder {
    id         String @id @default(uuid())
    childCount Int?
    view       View?
    item       Item   @relation(fields: [id], references: [id], onDelete: Cascade)
}

model Image {
    id                   String    @id @default(uuid())
    height               Int?
    width                Int?
    horizontalResolution Int?
    verticalResolution   Int?
    cameraMake           String?
    cameraModel          String?
    exposureDenominator  Float?
    exposureNumerator    Float?
    focalLength          Float?
    fNumber              Float?
    iso                  Int?
    takenDateTime        DateTime?
    item                 Item?     @relation(fields: [id], references: [id], onDelete: Cascade)
}

model Video {
    id                    String  @id @default(uuid())
    bitrate               Int?
    duration              Int?
    height                Int?
    width                 Int?
    audioBitsPerSample    Int?
    audioChannels         Int?
    audioFormat           String?
    audioSamplesPerSecond Int?
    frameRate             Float?
    fourCC                String?
    item                  Item?   @relation(fields: [id], references: [id], onDelete: Cascade)
}

model Audio {
    id                String   @id @default(uuid())
    album             String?
    albumArtist       String?
    artist            String?
    bitrate           Int?
    composers         String?
    copyright         String?
    disc              Int?
    discCount         Int?
    duration          Int?
    genre             String?
    hasDrm            Boolean?
    isVariableBitrate Boolean?
    title             String?
    track             Int?
    trackCount        Int?
    year              Int?
    item              Item?    @relation(fields: [id], references: [id], onDelete: Cascade)
}

model Photo {
    id                  String    @id @default(uuid())
    cameraMake          String?
    cameraModel         String?
    exposureDenominator Float?
    exposureNumerator   Float?
    fNumber             Float?
    focalLength         Float?
    iso                 Int?
    takenDateTime       DateTime?
    item                Item?     @relation(fields: [id], references: [id], onDelete: Cascade)
}
