model File {
  id         String  @id
  mimeType   String?
  hash       String?
  extension  String?
  bucket     String
  key        String
  /// Where the upload put it, `<rootId>/<folders>/<name>` as the browser saw it.
  /// A record of the upload, not the file's current place: a move or rename
  /// leaves it as it was. `key` is the object's own (`toObjectKey`).
  uploadPath String
  etag       String?
  itemId     String  @unique
  item       Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([bucket, key], map: "file_bucket_key")
}

model Folder {
  id                  String @id
  childCount          Int?   @default(0)
  inclusiveChildCount Int    @default(0)
  view                View?
  itemId              String @unique
  /// DO NOT reshape this relation without re-reading
  /// prisma/migrations/20260826000000_defer_folder_item_fk. That migration makes
  /// Folder_itemId_fkey DEFERRABLE INITIALLY DEFERRED — Prisma cannot express
  /// that here, so any change that makes Prisma DROP and re-ADD this constraint
  /// (renaming the field/model, changing onDelete, `prisma db push`) silently
  /// restores the immediate check and brings back the P2003 bulk-delete failure.
  item                Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Image {
  id                   String    @id
  height               Int?
  width                Int?
  horizontalResolution Int?
  verticalResolution   Int?
  bitDepth             Int?
  cameraMake           String?
  cameraModel          String?
  exposureTime         Float?
  focalLength          Float?
  fNumber              Float?
  iso                  Int?
  takenDateTime        DateTime?
  latitude             Float?
  longitude            Float?
  itemId               String    @unique
  item                 Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Video {
  id                    String  @id
  bitrate               Int?
  codec                 String?
  container             String?
  duration              Int?
  height                Int?
  width                 Int?
  audioBitsPerSample    Int?
  audioChannels         Int?
  audioFormat           String?
  audioSamplesPerSecond Int?
  frameRate             Float?
  fourCC                String?
  itemId                String  @unique
  item                  Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Pdf {
  id               String    @id
  pageCount        Int?
  title            String?
  author           String?
  subject          String?
  keywords         String?
  creator          String?
  producer         String?
  pdfVersion       String?
  language         String?
  isEncrypted      Boolean?
  hasFormFields    Boolean?
  hasAnnotations   Boolean?
  hasSignatures    Boolean?
  // First-page media box in PDF points (1pt = 1/72in) — drives "Page size"
  pageWidth        Float?
  pageHeight       Float?
  docCreatedAt     DateTime?
  docModifiedAt    DateTime?
  itemId           String    @unique
  item             Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Markdown {
  id              String    @id
  title           String?
  author          String?
  description     String?
  // Comma-joined frontmatter tags (mirrors Pdf.keywords)
  tags            String?
  wordCount       Int?
  // Estimated reading time in whole minutes
  readingTime     Int?
  headingCount    Int?
  linkCount       Int?
  imageCount      Int?
  codeBlockCount  Int?
  taskCount       Int?
  hasFrontmatter  Boolean?
  docCreatedAt    DateTime?
  docModifiedAt   DateTime?
  itemId          String    @unique
  item            Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model Audio {
  id                String   @id
  album             String?
  albumArtist       String?
  artist            String?
  composer          String?
  bitrate           Int?
  composers         String?
  copyright         String?
  disc              Int?
  discCount         Int?
  duration          Int?
  genre             String?
  hasDrm            Boolean?
  isVariableBitrate Boolean?
  title             String?
  track             Int?
  trackCount        Int?
  year              Int?
  itemId            String   @unique
  item              Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
}
