generator client {
  provider = "prisma-client"
  output   = "../../app/prisma"

  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  previewFeatures        = ["nativeDistinct", "relationJoins", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector, pg_trgm]
}
