model ItemVersion {
  id        String    @id
  updatedAt DateTime? @updatedAt @db.Timestamp()
  createdAt DateTime? @default(now()) @db.Timestamp()
  size      BigInt?
  content   Bytes?    @db.ByteA
  label     String?
  version   String?
  itemId    String?
  item      Item?     @relation(fields: [itemId], references: [id], onDelete: Cascade)
}
