{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if git diff --cached --name-only | grep -E '(^|/)\\.env(\\.|$)' | grep -vE '\\.env\\.example$' >&2; then echo 'BLOCK: .env file staged - unstage it before committing' >&2; exit 2; fi",
            "if": "Bash(git commit*)",
            "shell": "bash",
            "statusMessage": "Checking staged files for secrets"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/check-staged-types.mjs",
            "if": "Bash(git commit*)",
            "shell": "bash",
            "timeout": 240,
            "statusMessage": "Typechecking staged files against baseline"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/dev-server-guard.mjs",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Checking dev-server rules"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/protect-paths.mjs",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/convention-check.mjs",
            "shell": "bash",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node .claude/hooks/schema-reminder.mjs",
            "shell": "bash",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/stop-docs-nudge.mjs",
            "shell": "bash",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(cd /tmp)",
      "Bash(pwd -W)",
      "Read(//tmp/**)",
      "Bash(git diff *)",
      "PowerShell(node .claude/hooks/check-staged-types.mjs --all 2>&1)",
      "PowerShell(node .claude/hooks/check-staged-types.mjs --all; \"exit=$LASTEXITCODE\")",
      "Bash(bash .claude/scripts/wait-for-ci.sh)",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "ClaudeInChromeDomain(localhost)",
      "mcp__claude_ai_vinktar__list_projects",
      "mcp__claude_ai_vinktar__get_install_guide",
      "mcp__claude_ai_vinktar__get_setup_status",
      "mcp__claude_ai_vinktar__get_project_keys"
    ]
  }
}
