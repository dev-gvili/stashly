{
  "files": [],
  "references": [
    {
      "path": "./tsconfig.node.json"
    },
    {
      "path": "./tsconfig.vite.json"
    }
  ],
  "compilerOptions": {
    "checkJs": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@/*": [
        "./app/*"
      ],
      "@/db/*": [
        "./app/.server/db"
      ],
      "@/prisma/*": [
        "./app/prisma/*"
      ],
      "@/utils/*": [
        "./app/utils/*"
      ],
      "@/components/*": [
        "./app/components/*"
      ],
      "@/ui/*": [
        "./app/components/ui/*"
      ],
      "@/hooks/*": [
        "./app/hooks/*"
      ],
      "@/services/*": [
        "./app/.server/*"
      ],
      "@/machines/*": [
        "./app/machines/*"
      ],
      "@/schemas/*": [
        "./app/schemas/*"
      ]
    },
    "disableSizeLimit": true,
    "noEmit": true
  }
}