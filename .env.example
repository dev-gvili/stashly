# Copy to .env and fill in. app/.server/env.ts loads it at startup; variables
# already set in the environment win, and production (Fly) sets them as secrets
# instead of shipping a file. Never commit real values.

# --- Database (PostgreSQL 17 with pgvector) -----------------------------------
# The app's connection (app/.server/db.ts). In production it goes through PgBouncer.
DATABASE_URL=postgresql://user:password@localhost:5432/stashly
# Optional settings are commented out: an empty line would set an empty string,
# and prisma.config.ts reads DIRECT_DATABASE_URL with `??`, which keeps it.
#
# Optional: a direct connection, bypassing PgBouncer, for migrations
# (prisma.config.ts) and the notifications LISTEN (notification-events.ts).
# Falls back to DATABASE_URL.
# DIRECT_DATABASE_URL=
# Optional: app connection pool size and connect timeout. Defaults: 10, 10000.
# DATABASE_POOL_MAX=10
# DATABASE_POOL_TIMEOUT_MS=10000

# --- Auth ----------------------------------------------------------------------
# Signs better-auth sessions (app/.server/auth.ts). Any long random string.
BETTER_AUTH_SECRET=
# Signs the app's own cookies. Required in production: the server refuses to
# start without it.
SESSION_SECRET=
# OAuth providers: set the pairs for the ones you enable.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Object storage (S3-compatible: Tigris, AWS S3, …) ------------------------
# Used by app/.server/s3.ts. For Tigris on Fly, as CI uses it:
# AWS_ENDPOINT_URL=https://fly.storage.tigris.dev and AWS_REGION=auto.
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=
AWS_ENDPOINT_URL=

# --- Billing (Stripe) ----------------------------------------------------------
STRIPE_SECRET_KEY=
# Verifies webhook calls to /api/stripe.
STRIPE_WEBHOOK_SECRET=

# --- Email ---------------------------------------------------------------------
# Outgoing email service endpoint and its token (app/.server/email.ts).
EMAIL_SERVICE_URL=
EMAIL_SERVICE_TOKEN=

# --- Server --------------------------------------------------------------------
# Optional: dev server port (server.js). Default 80.
# PORT=80
# Optional: when set, /api/metrics needs ?token= or "Authorization: Bearer" with
# it; when unset, the route answers only outside production.
# METRICS_TOKEN=

# --- Vinktar -------------------------------------------------------------------
# Vinktar: product analytics and error tracking (app/.server/vinktar.ts, app/.client/vinktar.ts).
# The project's public write key (vnk_pk_…): it can only append events, and the
# root loader hands it to the browser at runtime.
VINKTAR_KEY=
# The git SHA of the deploy, the same on the server and in the browser.
# Production, with the browser source-map upload (Dockerfile, build stage):
#   fly deploy --build-secret VINKTAR_CLI_KEY=vnk_sk_… \
#     --build-arg VINKTAR_RELEASE=$(git rev-parse HEAD) \
#     --env VINKTAR_RELEASE=$(git rev-parse HEAD)
# VINKTAR_CLI_KEY is a secret ("cli" scope): keep it out of this file and the repo.
VINKTAR_RELEASE=
# Optional: production | staging | development. Defaults to NODE_ENV.
VINKTAR_ENVIRONMENT=
