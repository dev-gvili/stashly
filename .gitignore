# Claude Code local config — ignore personal config, keep project settings
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/tsc-baseline.json
!.claude/scripts/
# Subsystem skills are shared project guidance, not personal config. They must
# live here (not .agents/) — this is the only directory Claude Code loads
# skills from, and they never loaded while they sat outside it.
!.claude/skills/
# claude-ease generated project maps
.claude-ease/

