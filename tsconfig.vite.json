{
  "extends": "./tsconfig.json",
  "include": [
    ".react-router/types/**/*",
    "app/**/*",
    "app/**/.server/**/*",
    "app/**/.client/**/*",
    "database/**/*",
    "server/**/*",
    "prisma/seedData/stress-test.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "types": [
      "vite/client",
      "@webgpu/types"
    ],
    "typeRoots": [
       // or ensure typeRoots include node_modules
      "./node_modules/@webgpu/types"
    ],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "rootDirs": [
      ".",
      "./.react-router/types"
    ],
    "paths": {
      "@/*": [
        "./app/*"
      ],
      "@/db/*": [
        "./app/.server/db"
      ],
      "@/prisma/*": [
        "./app/prisma/*"
      ],
      "@/utils/*": [
        "./app/utils/*"
      ],
      "@/components/*": [
        "./app/components/*"
      ],
      "@/ui/*": [
        "./app/components/ui/*"
      ],
      "@/hooks/*": [
        "./app/hooks/*"
      ],
      "@/services/*": [
        "./app/.server/*"
      ],
      "@/machines/*": [
        "./app/machines/*"
      ]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true
  }
}